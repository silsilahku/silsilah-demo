      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  .family-app { font-family: 'Inter', sans-serif; }\n  .tree-grid { background-image: linear-gradient(to right, rgba(148,163,184,.11) 1px, transparent 1px), linear-gradient(to bottom, rgba(148,163,184,.08) 1px, transparent 1px); background-size: 32px 32px; }\n  .map-card { transform: translateZ(0); }\n  .map-card:hover { border-color: #818cf8; }\n  .mobile-only, .mobile-tray, .mobile-detail { display: none; }\n  @media (max-width: 920px) {\n    .desktop-only, .desktop-inspector, .desktop-context { display: none !important; }\n    .mobile-only { display: flex !important; }\n    .mobile-tray { display: flex !important; }\n    .tree-stage { min-height: calc(100svh - 112px); }\n    .mobile-canvas-tools { bottom: 9.5rem !important; }\n    .tree-map { transform: scale(.72); transform-origin: 0 0; width: 138%; height: 138%; }\n  }\n</style>\n<div class=\"family-app flex min-h-screen flex-col overflow-hidden bg-[#f8fafc] text-slate-800\" data-kid=\"1\" data-name=\"family tree application container\">\n    <header class=\"app-header relative z-30 flex h-[68px] shrink-0 items-center justify-between border-b border-slate-200 bg-white px-5 shadow-[0_1px_8px_rgba(15,23,42,0.04)] sm:px-7\" data-kid=\"1-1\" data-name=\"app header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"app logo and identity container\">\n            <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[11px] bg-indigo-600 shadow-sm shadow-indigo-200\" data-kid=\"1-1-1-1\" data-name=\"app logo icon container\">\n                <svg aria-hidden=\"true\" class=\"h-6 w-6\" data-kid=\"1-1-1-1-1\" data-name=\"family tree logo icon\" fill=\"none\" viewbox=\"0 0 24 24\">\n                    <path d=\"M12 3.5 8.6 8h2.1l-3.4 4.7h2.5L6.4 18h11.2l-3.4-5.3h2.5L13.3 8h2.1L12 3.5Z\" fill=\"#86efac\">\n                    </path>\n                    <path d=\"M12 17.5V21M9.2 21h5.6\" stroke=\"#14532d\" stroke-linecap=\"round\" stroke-width=\"1.7\">\n                    </path>\n                </svg>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"identity and status container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1\" data-name=\"app name and status container\">\n                    <h1 class=\"truncate text-[15px] font-bold tracking-[-0.02em] text-slate-900\" data-kid=\"1-1-1-2-1-1\" data-name=\"app name\">\n                        Garis Keturunan\n                    </h1>\n                    <span class=\"rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700\" data-kid=\"1-1-1-2-1-2\" data-name=\"user role label\">\n                        Admin\n                    </span>\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2 text-[11px] text-slate-500\" data-kid=\"1-1-1-2-2\" data-name=\"stats summary container\">\n                    <span class=\"font-semibold text-slate-700\" data-kid=\"1-1-1-2-2-1\" data-name=\"member count summary\">\n                        94 anggota\n                    </span>\n                    <span class=\"hidden h-3 w-px bg-slate-200 sm:block\" data-kid=\"1-1-1-2-2-2\" data-name=\"separator\">\n                    </span>\n                    <span class=\"hidden sm:block\" data-kid=\"1-1-1-2-2-3\" data-name=\"application title\">\n                        Silsilah keluarga\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"desktop-only flex min-w-0 items-center gap-2.5\" data-kid=\"1-1-2\" data-name=\"desktop controls group\">\n            <label class=\"relative block w-[280px]\" data-kid=\"1-1-2-1\" data-name=\"search input container\">\n                <span class=\"sr-only\" data-kid=\"1-1-2-1-1\" data-name=\"search label\">\n                    Cari anggota keluarga\n                </span>\n                <svg aria-hidden=\"true\" class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400\" data-kid=\"1-1-2-1-2\" data-name=\"search icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"11\" cy=\"11\" r=\"7\">\n                    </circle>\n                    <path d=\"m20 20-4-4\">\n                    </path>\n                </svg>\n                <input aria-label=\"Cari anggota keluarga\" class=\"h-10 w-full rounded-lg border border-slate-200 bg-slate-50 pl-9 pr-3 text-xs text-slate-800 outline-none placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/15\" data-kid=\"1-1-2-1-3\" data-name=\"search input\" value=\"Ali / iis\"/>\n                <span class=\"absolute right-2.5 top-1/2 -translate-y-1/2 rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[9px] font-semibold text-slate-400\" data-kid=\"1-1-2-1-4\" data-name=\"search keyboard shortcut hint\">\n                    ⌘ K\n                </span>\n            </label>\n            <button aria-label=\"Pengaturan tampilan\" class=\"flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500/20\" data-kid=\"1-1-2-2\" data-name=\"display settings button\">\n                <svg class=\"h-4 w-4 text-indigo-600\" data-kid=\"1-1-2-2-1\" data-name=\"settings icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 5h16M4 12h16M4 19h16\">\n                    </path>\n                    <circle cx=\"8\" cy=\"5\" fill=\"white\" r=\"2\">\n                    </circle>\n                    <circle cx=\"16\" cy=\"12\" fill=\"white\" r=\"2\">\n                    </circle>\n                    <circle cx=\"10\" cy=\"19\" fill=\"white\" r=\"2\">\n                    </circle>\n                </svg>\n                Tampilan\n                <svg class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-2-2-2\" data-name=\"dropdown arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                    <path d=\"m6 9 6 6 6-6\">\n                    </path>\n                </svg>\n            </button>\n            <button aria-label=\"Pengelolaan data\" class=\"flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500/20\" data-kid=\"1-1-2-3\" data-name=\"family data button\">\n                <svg class=\"h-4 w-4 text-slate-600\" data-kid=\"1-1-2-3-1\" data-name=\"database icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 5h16v14H4z\">\n                    </path>\n                    <path d=\"M8 9h8M8 13h5\">\n                    </path>\n                </svg>\n                Data keluarga\n                <svg class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-2-3-2\" data-name=\"dropdown arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                    <path d=\"m6 9 6 6 6-6\">\n                    </path>\n                </svg>\n            </button>\n            <button aria-label=\"Menu akun\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 focus:outline-none focus:ring-2 focus:ring-rose-500/20\" data-kid=\"1-1-2-4\" data-name=\"account menu button\">\n                <svg class=\"h-4 w-4\" data-kid=\"1-1-2-4-1\" data-name=\"user account icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\">\n                    </path>\n                    <path d=\"m16 17 5-5-5-5M21 12H9\">\n                    </path>\n                </svg>\n            </button>\n        </div>\n        <div class=\"mobile-only items-center gap-2\" data-kid=\"1-1-3\" data-name=\"mobile controls container\">\n            <button aria-label=\"Cari anggota\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700\" data-kid=\"1-1-3-1\" data-name=\"mobile search button\">\n                <svg class=\"h-5 w-5\" data-kid=\"1-1-3-1-1\" data-name=\"search icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                    <circle cx=\"11\" cy=\"11\" r=\"7\">\n                    </circle>\n                    <path d=\"m20 20-4-4\">\n                    </path>\n                </svg>\n            </button>\n            <button aria-label=\"Buka menu\" class=\"flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700\" data-kid=\"1-1-3-2\" data-name=\"mobile menu button\">\n                <svg class=\"h-5 w-5\" data-kid=\"1-1-3-2-1\" data-name=\"menu icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 6h16M4 12h16M4 18h16\">\n                    </path>\n                </svg>\n            </button>\n        </div>\n    </header>\n    <main class=\"flex min-h-0 flex-1\" data-kid=\"1-2\" data-name=\"main content workspace\">\n        <section aria-label=\"Silsilah keluarga. Gunakan pencarian dan tombol pusatkan untuk navigasi.\" class=\"tree-stage relative min-w-0 flex-1 overflow-hidden bg-[#f8fafc]\" data-kid=\"1-2-1\" data-name=\"tree visualization stage\">\n            <div class=\"pointer-events-none absolute inset-0 flex opacity-70\" data-kid=\"1-2-1-1\" data-name=\"generations background tracker\">\n                <div class=\"relative w-[19%] border-r border-slate-200/80 bg-white/25\" data-kid=\"1-2-1-1-1\" data-name=\"generation 1 marker\">\n                    <span class=\"absolute left-4 top-24 text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-300\" data-kid=\"1-2-1-1-1-1\" data-name=\"generation 1 text label\">\n                        Generasi 1\n                    </span>\n                </div>\n                <div class=\"relative w-[20%] border-r border-slate-200/80\" data-kid=\"1-2-1-1-2\" data-name=\"generation 2 marker\">\n                    <span class=\"absolute left-4 top-24 text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-300\" data-kid=\"1-2-1-1-2-1\" data-name=\"generation 2 text label\">\n                        Generasi 2\n                    </span>\n                </div>\n                <div class=\"relative w-[20%] border-r border-slate-200/80 bg-white/25\" data-kid=\"1-2-1-1-3\" data-name=\"generation 3 marker\">\n                    <span class=\"absolute left-4 top-24 text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-300\" data-kid=\"1-2-1-1-3-1\" data-name=\"generation 3 text label\">\n                        Generasi 3\n                    </span>\n                </div>\n                <div class=\"relative w-[20%] border-r border-slate-200/80\" data-kid=\"1-2-1-1-4\" data-name=\"generation 4 marker\">\n                    <span class=\"absolute left-4 top-24 text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-300\" data-kid=\"1-2-1-1-4-1\" data-name=\"generation 4 text label\">\n                        Generasi 4\n                    </span>\n                </div>\n                <div class=\"relative flex-1 bg-white/25\" data-kid=\"1-2-1-1-5\" data-name=\"generation 5 marker\">\n                    <span class=\"absolute left-4 top-24 text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-300\" data-kid=\"1-2-1-1-5-1\" data-name=\"generation 5 text label\">\n                        Generasi 5\n                    </span>\n                </div>\n            </div>\n            <div class=\"tree-grid pointer-events-none absolute inset-0 opacity-[0.18]\" data-kid=\"1-2-1-2\" data-name=\"grid background pattern\">\n            </div>\n            <div class=\"desktop-context absolute left-5 top-5 z-20 flex items-center gap-3 rounded-xl border border-slate-200 bg-white/95 px-3.5 py-2.5 shadow-sm\" data-kid=\"1-2-1-3\" data-name=\"desktop legend and context bar\">\n                <div class=\"flex items-center gap-2 border-r border-slate-200 pr-3\" data-kid=\"1-2-1-3-1\" data-name=\"gender legend container\">\n                    <span class=\"h-2.5 w-2.5 rounded-full bg-blue-500\" data-kid=\"1-2-1-3-1-1\" data-name=\"male indicator circle\">\n                    </span>\n                    <span class=\"text-[11px] text-slate-600\" data-kid=\"1-2-1-3-1-2\" data-name=\"male gender label\">\n                        Pria\n                    </span>\n                    <span class=\"h-2.5 w-2.5 rounded-full bg-pink-500\" data-kid=\"1-2-1-3-1-3\" data-name=\"female indicator circle\">\n                    </span>\n                    <span class=\"text-[11px] text-slate-600\" data-kid=\"1-2-1-3-1-4\" data-name=\"female gender label\">\n                        Wanita\n                    </span>\n                </div>\n                <label class=\"flex items-center gap-2 text-[11px] font-semibold text-slate-700\" data-kid=\"1-2-1-3-2\" data-name=\"highlight toggle label\">\n                    Sorot garis keluarga\n                    <span class=\"relative inline-flex h-5 w-9 rounded-full bg-indigo-600\" data-kid=\"1-2-1-3-2-1\" data-name=\"highlight toggle switch track\">\n                        <span class=\"absolute right-0.5 top-0.5 h-4 w-4 rounded-full bg-white shadow-sm\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"highlight toggle switch knob\">\n                        </span>\n                    </span>\n                </label>\n                <span class=\"h-4 w-px bg-slate-200\" data-kid=\"1-2-1-3-3\" data-name=\"legend separator\">\n                </span>\n                <span class=\"text-[11px] text-slate-500\" data-kid=\"1-2-1-3-4\" data-name=\"current selection status\">\n                    <span class=\"font-semibold text-indigo-600\" data-kid=\"1-2-1-3-4-1\" data-name=\"selected member name\">\n                        Ali / iis\n                    </span>\n                    dipilih\n                </span>\n            </div>\n            <div class=\"mobile-only absolute left-3 right-3 top-3 z-20 items-center justify-between rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm\" data-kid=\"1-2-1-4\" data-name=\"mobile selection status bar\">\n                <span class=\"text-xs font-semibold text-slate-800\" data-kid=\"1-2-1-4-1\" data-name=\"selected member name\">\n                    Ali / iis dipilih\n                </span>\n                <span class=\"flex items-center gap-2 text-[11px] font-medium text-indigo-700\" data-kid=\"1-2-1-4-2\" data-name=\"highlight toggle control\">\n                    Sorot garis keluarga\n                    <span class=\"relative inline-flex h-5 w-9 rounded-full bg-indigo-600\" data-kid=\"1-2-1-4-2-1\" data-name=\"highlight toggle track\">\n                        <span class=\"absolute right-0.5 top-0.5 h-4 w-4 rounded-full bg-white\" data-kid=\"1-2-1-4-2-1-1\" data-name=\"highlight toggle knob\">\n                        </span>\n                    </span>\n                </span>\n            </div>\n            <div class=\"tree-map absolute inset-0 origin-top-left\" data-kid=\"1-2-1-5\" data-name=\"family tree map container\">\n                <svg aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 h-full w-full\" data-kid=\"1-2-1-5-1\" data-name=\"connection lines svg\" fill=\"none\" preserveaspectratio=\"none\" viewbox=\"0 0 1060 820\">\n                    <path d=\"M110 285H225V410H340\" stroke=\"#cbd5e1\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M110 510H225V410H340\" stroke=\"#cbd5e1\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M340 410H450V300H570\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M340 410H450V540H570\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M570 300H665V255H770\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M570 300H665V365H770\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M570 540H665V500H770\" stroke=\"#cbd5e1\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M570 540H665V610H770\" stroke=\"#cbd5e1\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M770 365H855V320H950\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M770 365H855V440H950\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <path d=\"M770 610H855V560H950\" stroke=\"#cbd5e1\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M770 610H855V680H950\" stroke=\"#cbd5e1\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M770 365H770\" stroke=\"#6366f1\" stroke-width=\"2.5\">\n                    </path>\n                    <circle cx=\"450\" cy=\"410\" fill=\"white\" r=\"12\" stroke=\"#818cf8\" stroke-width=\"2\">\n                    </circle>\n                    <path d=\"M445 410h10\" stroke=\"#4f46e5\" stroke-linecap=\"round\" stroke-width=\"2\">\n                    </path>\n                    <circle cx=\"665\" cy=\"365\" fill=\"white\" r=\"12\" stroke=\"#818cf8\" stroke-width=\"2\">\n                    </circle>\n                    <path d=\"M660 365h10\" stroke=\"#4f46e5\" stroke-linecap=\"round\" stroke-width=\"2\">\n                    </path>\n                </svg>\n                <div class=\"map-card absolute left-[46px] top-[230px] flex h-[110px] w-[220px] flex-col justify-between rounded-xl border-2 border-blue-200 bg-white p-3 shadow-sm\" data-kid=\"1-2-1-5-2\" data-name=\"member profile card\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-5-2-1\" data-name=\"profile header container\">\n                        <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700\" data-kid=\"1-2-1-5-2-1-1\" data-name=\"initials badge\">\n                            A\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-2-1-5-2-1-2\" data-name=\"name and status container\">\n                            <div class=\"truncate text-xs font-semibold text-slate-800\" data-kid=\"1-2-1-5-2-1-2-1\" data-name=\"member name\">\n                                Abah Sukata\n                            </div>\n                            <div class=\"text-[10px] font-medium text-slate-500\" data-kid=\"1-2-1-5-2-1-2-2\" data-name=\"member age and status\">\n                                74 thn · Wafat\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"border-t border-slate-100 pt-1.5 text-[10px] text-slate-500\" data-kid=\"1-2-1-5-2-2\" data-name=\"profile role text\">\n                        Pendiri keluarga\n                    </div>\n                </div>\n                <div class=\"map-card absolute left-[46px] top-[455px] flex h-[110px] w-[220px] flex-col justify-between rounded-xl border-2 border-pink-200 bg-white p-3 shadow-sm\" data-kid=\"1-2-1-5-3\" data-name=\"member profile card\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-5-3-1\" data-name=\"profile header container\">\n                        <div class=\"flex h-9 w-9 items-center justify-