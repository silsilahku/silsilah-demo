    "var_467dcd1bb7c6": {
      "type": "variant",
      "label": "Family map table — responsive revamp",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4585.935483870968,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  html, body { margin: 0; min-height: 100%; background: #f1f5f9; }\n  body { font-family: 'Inter', sans-serif; color: #334155; }\n  button, input, textarea, select { font: inherit; }\n  .family-app { min-height: 100dvh; background: #f8fafc; overflow: hidden; }\n  .topbar { height: 64px; }\n  .workspace { height: calc(100dvh - 64px); min-height: 720px; }\n  .canvas-pane { min-width: 0; position: relative; overflow: hidden; background: #f8fafc; }\n  .canvas-viewport { position: absolute; inset: 0; overflow: hidden; }\n  .generation-lane { position: absolute; top: 0; bottom: 0; width: 25%; border-right: 1px solid rgba(226,232,240,.7); }\n  .generation-lane:nth-child(1) { left: 0; background: rgba(241,245,249,.32); }\n  .generation-lane:nth-child(2) { left: 25%; background: rgba(248,250,252,.42); }\n  .generation-lane:nth-child(3) { left: 50%; background: rgba(241,245,249,.30); }\n  .generation-lane:nth-child(4) { left: 75%; background: rgba(248,250,252,.44); border-right: 0; }\n  .lane-label { position: absolute; left: 12px; top: 88px; writing-mode: vertical-rl; transform: rotate(180deg); letter-spacing: .08em; font-size: 9px; color: #94a3b8; text-transform: uppercase; }\n  .map-layer { position: absolute; width: 1080px; height: 790px; left: 30px; top: 88px; transform: scale(.78); transform-origin: top left; }\n  .map-svg { position: absolute; inset: 0; width: 1080px; height: 790px; overflow: visible; pointer-events: none; }\n  .person-node { position: absolute; width: 220px; height: 110px; border-radius: 14px; background: #fff; border: 2px solid #dbeafe; box-shadow: 0 8px 20px rgba(15,23,42,.06); padding: 12px; display: flex; flex-direction: column; justify-content: space-between; }\n  .person-node.female { border-color: #fbcfe8; }\n  .person-node.deceased { background: #f1f5f9; border-color: #cbd5e1; }\n  .person-node.selected { border-color: #4f46e5; box-shadow: 0 0 0 7px rgba(79,70,229,.12), 0 12px 28px rgba(79,70,229,.15); z-index: 4; }\n  .person-node.selected::after { content: ''; position: absolute; inset: -13px; border: 1px solid rgba(79,70,229,.35); border-radius: 18px; pointer-events: none; }\n  .avatar { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; font-size: 14px; font-weight: 700; }\n  .avatar.male { background: #dbeafe; color: #1d4ed8; }\n  .avatar.female { background: #fce7f3; color: #be185d; }\n  .avatar.neutral { background: #e2e8f0; color: #475569; }\n  .node-action { min-width: 32px; min-height: 28px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid #e2e8f0; border-radius: 8px; color: #64748b; background: #fff; font-size: 10px; font-weight: 600; }\n  .node-action.primary { color: #4338ca; background: #eef2ff; border-color: #c7d2fe; }\n  .context-strip { position: absolute; left: 22px; top: 18px; z-index: 8; display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: rgba(255,255,255,.96); border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 5px 15px rgba(15,23,42,.05); }\n  .map-tools { position: absolute; right: 20px; top: 18px; z-index: 8; display: flex; gap: 8px; }\n  .tool-button { min-width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid #cbd5e1; border-radius: 10px; background: #fff; color: #475569; font-size: 11px; font-weight: 600; box-shadow: 0 3px 10px rgba(15,23,42,.04); }\n  .tool-button:hover { background: #f8fafc; }\n  .zoom-stack { position: absolute; z-index: 8; right: 20px; bottom: 22px; display: flex; flex-direction: column; gap: 8px; }\n  .zoom-button { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid #cbd5e1; border-radius: 10px; background: #fff; color: #334155; font-size: 18px; box-shadow: 0 5px 12px rgba(15,23,42,.06); }\n  .inspector { width: 352px; flex: 0 0 352px; background: #fff; border-left: 1px solid #cbd5e1; position: relative; z-index: 12; display: flex; flex-direction: column; }\n  .inspector-scroll { min-height: 0; overflow-y: auto; padding: 20px 20px 112px; }\n  .field-label { display: block; margin-bottom: 6px; color: #475569; font-size: 11px; font-weight: 600; }\n  .field-input { width: 100%; height: 40px; box-sizing: border-box; border: 1px solid #cbd5e1; border-radius: 9px; background: #f8fafc; padding: 0 11px; color: #1e293b; font-size: 12px; }\n  .field-input:focus { outline: 2px solid #818cf8; outline-offset: 2px; }\n  .sticky-footer { position: absolute; left: 0; right: 0; bottom: 0; padding: 14px 20px calc(14px + env(safe-area-inset-bottom)); border-top: 1px solid #e2e8f0; background: rgba(255,255,255,.98); }\n  .mobile-search { display: none; }\n  .mobile-sheet-backdrop { display: none; }\n  .relation-row { min-height: 40px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #f1f5f9; }\n  .relation-row:last-child { border-bottom: 0; }\n  .relation-name { color: #334155; font-size: 12px; font-weight: 600; text-align: left; }\n  .relation-name:hover { color: #4338ca; text-decoration: underline; }\n  .status-note { border-radius: 9px; padding: 8px 10px; background: #ecfdf5; color: #047857; font-size: 11px; font-weight: 600; }\n  .hide-scrollbar::-webkit-scrollbar { width: 6px; }\n  .hide-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 6px; }\n  @media (max-width: 820px) {\n    .family-app { overflow: auto; }\n    .topbar { height: 64px; }\n    .workspace { min-height: calc(100dvh - 64px); height: calc(100dvh - 64px); display: block; position: relative; }\n    .desktop-search, .desktop-tools, .desktop-account, .desktop-data { display: none !important; }\n    .mobile-search { display: flex; position: absolute; top: 72px; left: 14px; right: 14px; z-index: 15; height: 44px; align-items: center; gap: 9px; padding: 0 13px; border: 1px solid #cbd5e1;