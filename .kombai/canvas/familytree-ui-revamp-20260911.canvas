      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  html, body { margin: 0; min-height: 100%; background: #f1f5f9; }\n  body { font-family: 'Inter', sans-serif; }\n  button, input { font: inherit; }\n  .tree-first-app { min-height: 860px; color: #1e293b; background: #f1f5f9; }\n  .app-header { height: 64px; }\n  .tree-main { height: 796px; }\n  .tree-stage { background-color: #f8fafc; background-image: linear-gradient(to right, rgba(226,232,240,.34) 1px, transparent 1px), linear-gradient(to bottom, rgba(226,232,240,.28) 1px, transparent 1px); background-size: 34px 34px; }\n  .tree-world { position: absolute; inset: 0; transform-origin: 0 0; }\n  .tree-card { position: absolute; width: 198px; height: 98px; }\n  .tree-card.selected { width: 212px; height: 106px; }\n  .inspector { position: absolute; top: 0; right: 0; bottom: 0; width: 340px; z-index: 40; }\n  .inspector-scroll { padding-bottom: 104px; }\n  .index-drawer { display: none; }\n  .mobile-search-launcher { display: none; }\n  .focus-ring:focus-visible { outline: 2px solid #4f46e5; outline-offset: 2px; }\n  .scrollbar::-webkit-scrollbar { width: 5px; }\n  .scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 999px; }\n  @media (max-width: 900px) {\n    .tree-first-app { min-height: 100dvh; }\n    .app-header { height: 64px !important; padding: 0 12px !important; }\n    .desktop-actions { display: none !important; }\n    .mobile-actions { display: flex !important; }\n    .tree-main { height: calc(100dvh - 64px); }\n    .mobile-search-launcher { display: flex; position: absolute; left: 12px; right: 12px; top: 12px; z-index: 20; }\n    .tree-world { transform: scale(.67); }\n    .inspector { position: fixed; inset: 64px 0 0; width: auto; max-width: none; border-left: 0; border-top: 1px solid #e2e8f0; border-radius: 22px 22px 0 0; box-shadow: 0 -12px 36px rgba(15,23,42,.16); }\n    .mobile-grab { display: block !important; }\n    .context-strip { top: 70px !important; left: 12px !important; right: 12px !important; }\n    .context-strip .context-detail { display: none; }\n    .legend-bar { bottom: 16px !important; left: 12px !important; }\n    .map-tools { right: 12px !important; bottom: max(1rem, env(safe-area-inset-bottom)) !important; }\n  }\n</style>\n<div class=\"tree-first-app w-full overflow-hidden\" data-kid=\"1\" data-name=\"tree-first family archive\">\n    <header class=\"app-header relative z-50 flex items-center justify-between border-b border-slate-200 bg-white px-5 shadow-[0_1px_8px_rgba(15,23,42,0.05)]\" data-kid=\"1-1\" data-name=\"app header\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"application branding container\">\n            <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-white shadow-sm shadow-indigo-600/20\" data-kid=\"1-1-1-1\" data-name=\"family tree logo icon background\">\n                <svg aria-hidden=\"true\" class=\"h-6 w-6 text-emerald-300\" data-kid=\"1-1-1-1-1\" data-name=\"family tree logo icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                    <path d=\"M12 2.5c-1.2 0-2.1 1-2.1 2.2v1.1C7.8 6.2 6.2 8.1 6.2 10.4c0 .4.1.8.2 1.2-1.5.7-2.5 2.2-2.5 4 0 2.4 1.9 4.3 4.3 4.3h2.7v1.8h2.2v-1.8h2.6c2.4 0 4.3-1.9 4.3-4.3 0-1.8-1-3.3-2.5-4 .1-.4.2-.8.2-1.2 0-2.3-1.6-4.2-3.7-4.6V4.7c0-1.2-.9-2.2-2.1-2.2h-1.7Z\">\n                    </path>\n                </svg>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"application title container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1\" data-name=\"application name and badge row\">\n                    <h1 class=\"truncate text-[13px] font-bold tracking-[-0.01em] text-slate-800\" data-kid=\"1-1-1-2-1-1\" data-name=\"application title\">\n                        Garis Keturunan\n                    </h1>\n                    <span class=\"rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700\" data-kid=\"1-1-1-2-1-2\" data-name=\"admin status badge\">\n                        Admin\n                    </span>\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"application statistics row\">\n                    <span class=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600\" data-kid=\"1-1-1-2-2-1\" data-name=\"member count badge\">\n                        94 anggota\n                    </span>\n                    <span class=\"hidden text-[10px] text-slate-400 sm:inline\" data-kid=\"1-1-1-2-2-2\" data-name=\"tree description text\">\n                        Pohon keluarga · 5 generasi terlihat\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"desktop-actions flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"desktop navigation actions container\">\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-1\" data-name=\"members list button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-1-1\" data-name=\"members list icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 5h16M4 12h16M4 19h10\">\n                    </path>\n                    <circle cx=\"17\" cy=\"19\" r=\"3\">\n                    </circle>\n                </svg>\n                Daftar anggota\n            </button>\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-2\" data-name=\"view options button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-2-1\" data-name=\"view options icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 12h16M14 6l6 6-6 6\">\n                    </path>\n                </svg>\n                Tampilan\n                <svg class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-2-2-2\" data-name=\"view options dropdown arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"m7 10 5 5 5-5\">\n                    </path>\n                </svg>\n            </button>\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-3\" data-name=\"statistics button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-3-1\" data-name=\"statistics icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 19V5M4 19h16M7 16l3-4 3 2 4-6\">\n                    </path>\n                </svg>\n                Statistik\n            </button>\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-semibold text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-4\" data-name=\"family data button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-4-1\" data-name=\"family data icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 7h16M4 12h16M4 17h10\">\n                    </path>\n                </svg>\n                Data keluarga\n                <svg class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-2-4-2\" data-name=\"family data dropdown arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"m7 10 5 5 5-5\">\n                    </path>\n                </svg>\n            </button>\n            <button aria-label=\"Keluar\" class=\"focus-ring flex h-10 w-10 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100\" data-kid=\"1-1-2-5\" data-name=\"logout button\">\n                <svg class=\"h-4 w-4\" data-kid=\"1-1-2-5-1\" data-name=\"logout icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M9 21H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9\">\n                    </path>\n                </svg>\n            </button>\n        </div>\n        <div class=\"mobile-actions hidden items-center gap-2\" data-kid=\"1-1-3\" data-name=\"mobile navigation actions container\">\n            <button aria-label=\"Buka menu\" class=\"focus-ring flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600\" data-kid=\"1-1-3-1\" data-name=\"mobile menu button\">\n                <svg class=\"h-5 w-5\" data-kid=\"1-1-3-1-1\" data-name=\"hamburger menu icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 6h16M4 12h16M4 18h16\">\n                    </path>\n                </svg>\n            </button>\n        </div>\n    </header>\n    <main class=\"tree-main relative\" data-kid=\"1-2\" data-name=\"tree application main content\">\n        <section aria-label=\"Silsilah keluarga\" class=\"tree-stage absolute inset-0 overflow-hidden\" data-kid=\"1-2-1\" data-name=\"family tree visual stage\">\n            <button class=\"mobile-search-launcher focus-ring h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 shadow-sm\" data-kid=\"1-2-1-1\" data-name=\"mobile search launcher button\">\n                <svg class=\"h-4 w-4 text-slate-400\" data-kid=\"1