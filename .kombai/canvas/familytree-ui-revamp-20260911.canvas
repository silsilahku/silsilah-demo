                    A\n                    </div>\n                    <div data-kid=\"1-2-2-2-1-2\" data-name=\"name and status container\">\n                        <h2 class=\"text-base font-bold text-slate-900\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"member full name\">\n                            Ali / iis\n                        </h2>\n                        <p class=\"mt-0.5 text-xs text-slate-500\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"nickname\">\n                            Ali Iskandar\n                        </p>\n                        <p class=\"mt-1 text-[11px] font-medium text-emerald-700\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"age and status info\">\n                            45 tahun · Aktif\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex items-center gap-3 border-y border-slate-100 py-3 text-[11px]\" data-kid=\"1-2-2-2-2\" data-name=\"biometric grid\">\n                    <div data-kid=\"1-2-2-2-2-1\" data-name=\"domicile info\">\n                        <p class=\"text-slate-400\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"domicile label\">\n                            Domisili\n                        </p>\n                        <p class=\"mt-0.5 font-semibold text-slate-800\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"domicile value\">\n                            Citayam\n                        </p>\n                    </div>\n                    <div class=\"h-7 w-px bg-slate-200\" data-kid=\"1-2-2-2-2-2\" data-name=\"separator\">\n                    </div>\n                    <div data-kid=\"1-2-2-2-2-3\" data-name=\"birth year info\">\n                        <p class=\"text-slate-400\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"birth year label\">\n                            Tahun lahir\n                        </p>\n                        <p class=\"mt-0.5 font-semibold text-slate-800\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"birth year value\">\n                            1981\n                        </p>\n                    </div>\n                    <div class=\"h-7 w-px bg-slate-200\" data-kid=\"1-2-2-2-2-4\" data-name=\"separator\">\n                    </div>\n                    <div data-kid=\"1-2-2-2-2-5\" data-name=\"gender info\">\n                        <p class=\"text-slate-400\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"gender label\">\n                            Jenis kelamin\n                        </p>\n                        <p class=\"mt-0.5 font-semibold text-slate-800\" data-kid=\"1-2-2-2-2-5-2\" data-name=\"gender value\">\n                            Laki-laki\n                        </p>\n                    </div>\n                </div>\n                <section class=\"mt-5\" data-kid=\"1-2-2-2-3\" data-name=\"relationships section\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-2-2-3-1\" data-name=\"relationships section header\">\n                        <h3 class=\"text-xs font-bold text-slate-900\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"section title\">\n                            Hubungan terdekat\n                        </h3>\n                        <button class=\"text-[11px] font-semibold text-indigo-600\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"focus link\">\n                            Pusatkan\n                        </button>\n                    </div>\n                    <div class=\"divide-y divide-slate-100 rounded-lg border border-slate-200\" data-kid=\"1-2-2-2-3-2\" data-name=\"relationships link list\">\n                        <button class=\"flex min-h-10 w-full items-center justify-between px-3 text-left hover:bg-slate-50\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"parent relationship\">\n                            <span class=\"text-[11px] font-medium text-slate-500\" data-kid=\"1-2-2-2-3-2-1-1\" data-name=\"relationship label\">\n                                Orang tua\n                            </span>\n                            <span class=\"text-[11px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-3-2-1-2\" data-name=\"relationship names\">\n                                Wa Eyo · Ceu Iyah\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center justify-between px-3 text-left hover:bg-slate-50\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"spouse relationship\">\n                            <span class=\"text-[11px] font-medium text-slate-500\" data-kid=\"1-2-2-2-3-2-2-1\" data-name=\"relationship label\">\n                                Pasangan\n                            </span>\n                            <span class=\"text-[11px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-3-2-2-2\" data-name=\"relationship name\">\n                                Ika\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center justify-between px-3 text-left hover:bg-slate-50\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"sibling relationship\">\n                            <span class=\"text-[11px] font-medium text-slate-500\" data-kid=\"1-2-2-2-3-2-3-1\" data-name=\"relationship label\">\n                                Saudara kandung\n                            </span>\n                            <span class=\"max-w-[170px] text-right text-[11px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-3-2-3-2\" data-name=\"relationship names\">\n                                Adi, Mbu / Mba Nur\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-10 w-full items-center justify-between px-3 text-left hover:bg-slate-50\" data-kid=\"1-2-2-2-3-2-4\" data-name=\"children relationship\">\n                            <span class=\"text-[11px] font-medium text-slate-500\" data-kid=\"1-2-2-2-3-2-4-1\" data-name=\"relationship label\">\n                                Anak\n                            </span>\n                            <span class=\"text-[11px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-3-2-4-2\" data-name=\"relationship names\">\n                                Hafidz, Hanin\n                            </span>\n                        </button>\n                    </div>\n                </section>\n                <section class=\"mt-6\" data-kid=\"1-2-2-2-4\" data-name=\"personal info section\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-2-2-4-1\" data-name=\"personal info header\">\n                        <h3 class=\"text-xs font-bold text-slate-900\" data-kid=\"1-2-2-2-4-1-1\" data-name=\"section title\">\n                            Informasi pribadi\n                        </h3>\n                        <span class=\"text-[10px] font-medium text-slate-400\" data-kid=\"1-2-2-2-4-1-2\" data-name=\"role tag\">\n                            Admin\n                        </span>\n                    </div>\n                    <div class=\"space-y-3\" data-kid=\"1-2-2-2-4-2\" data-name=\"personal info fields\">\n                        <label class=\"block\" data-kid=\"1-2-2-2-4-2-1\" data-name=\"nickname label/input container\">\n                            <span class=\"mb-1.5 block text-[11px] font-semibold text-slate-600\" data-kid=\"1-2-2-2-4-2-1-1\" data-name=\"label\">\n                                Nama panggilan\n                            </span>\n                            <input class=\"h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/15\" data-kid=\"1-2-2-2-4-2-1-2\" data-name=\"input\" value=\"Ali / iis\"/>\n                        </label>\n                        <label class=\"block\" data-kid=\"1-2-2-2-4-2-2\" data-name=\"full name label/input container\">\n                            <span class=\"mb-1.5 block text-[11px] font-semibold text-slate-600\" data-kid=\"1-2-2-2-4-2-2-1\" data-name=\"label\">\n                                Nama lengkap\n                            </span>\n                            <input class=\"h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/15\" data-kid=\"1-2-2-2-4-2-2-2\" data-name=\"input\" value=\"Ali Iskandar\"/>\n                        </label>\n                        <div data-kid=\"1-2-2-2-4-2-3\" data-name=\"gender selection container\">\n                            <span class=\"mb-1.5 block text-[11px] font-semibold text-slate-600\" data-kid=\"1-2-2-2-4-2-3-1\" data-name=\"label\">\n                                Jenis kelamin\n                            </span>\n                            <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-2-2-2-4-2-3-2\" data-name=\"selection toggles\">\n                                <button class=\"h-10 rounded-lg border-2 border-blue-500 bg-blue-50 text-xs font-semibold text-blue-700\" data-kid=\"1-2-2-2-4-2-3-2-1\" data-name=\"male button\">\n                                    Laki-laki\n                                </button>\n                                <button class=\"h-10 rounded-lg border border-slate-200 bg-slate-50 text-xs font-medium text-slate-600\" data-kid=\"1-2-2-2-4-2-3-2-2\" data-name=\"female button\">\n                                    Perempuan\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-2-2-2-4-2-4\" data-name=\"year fields container\">\n                            <label class=\"block\" data-kid=\"1-2-2-2-4-2-4-1\" data-name=\"birth year field\">\n                                <span class=\"mb-1.5 block text-[11px] font-semibold text-slate-600\" data-kid=\"1-2-2-2-4-2-4-1-1\" data-name=\"label\">\n                                    Tahun lahir\n                                </span>\n                                <input class=\"h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-800\" data-kid=\"1-2-2-2-4-2-4-1-2\" data-name=\"input\" value=\"1981\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-2-2-2-4-2-4-2\" data-name=\"death year field\">\n                                <span class=\"mb-1.5 block text-[11px] font-semibold text-slate-600\" data-kid=\"1-2-2-2-4-2-4-2-1\" data-name=\"label\">\n                                    Tahun wafat\n                                </span>\n                                <input class=\"h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-400\" data-kid=\"1-2-2-2-4-2-4-2-2\" data-name=\"input\" disabled=\"\" value=\"—\"/>\n                            </label>\n                        </div>\n                    </div>\n                </section>\n                <section class=\"mt-6\" data-kid=\"1-2-2-2-5\" data-name=\"media section\">\n                    <h3 class=\"mb-2 text-xs font-bold text-slate-900\" data-kid=\"1-2-2-2-5-1\" data-name=\"section title\">\n                        Catatan & media\n                    </h3>\n                    <div class=\"space-y-3\" data-kid=\"1-2-2-2-5-2\" data-name=\"media fields\">\n                        <label class=\"block\" data-kid=\"1-2-2-2-5-2-1\" data-name=\"biography field\">\n                            <span class=\"mb-1.5 block text-[11px] font-semibold text-slate-600\" data-kid=\"1-2-2-2-5-2-1-1\" data-name=\"label\">\n                                Biografi ringkas / link sosial\n                            </span>\n                            <textarea class=\"min-h-[64px] w-full resize-none rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-500 outline-none\" data-kid=\"1-2-2-2-5-2-1-2\" data-name=\"textarea\" placeholder=\"Tambahkan informasi singkat...\"></textarea>\n                        </label>\n                        <button class=\"flex h-10 w-full items-center justify-between rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50\" data-kid=\"1-2-2-2-5-2-2\" data-name=\"photo management button\">\n                            <span data-kid=\"1-2-2-2-5-2-2-1\" data-name=\"button label\">\n                                Foto anggota\n                            </span>\n                            <span class=\"text-indigo-600\" data-kid=\"1-2-2-2-5-2-2-2\" data-name=\"action label\">\n                                Kelola foto\n                            </span>\n                        </button>\n                    </div>\n                </section>\n                <div class=\"mt-6 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5 text-[11px] leading-relaxed text-rose-700\" data-kid=\"1-2-2-2-6\" data-name=\"unsaved changes warning\">\n                    <span class=\"font-semibold\" data-kid=\"1-2-2-2-6-1\" data-name=\"warning label\">\n                        Perubahan belum tersimpan.\n                    </span>\n                    Periksa koneksi lalu coba lagi.\n                </div>\n            </div>\n            <div class=\"absolute bottom-0 left-0 right-0 border-t border-slate-200 bg-white/95 px-5 py-3 backdrop-blur-sm\" data-kid=\"1-2-2-3\" data-name=\"inspector footer\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1\" data-name=\"action buttons\">\n                    <button class=\"h-10 flex-1 rounded-lg bg-indigo-600 text-xs font-semibold text-white shadow-sm hover:bg-indigo-700\" data-kid=\"1-2-2-3-1-1\" data-name=\"save button\">\n                        Simpan perubahan\n                    </button>\n                    <button class=\"h-10 rounded-lg border border-rose-200 px-3 text-xs font-semibold text-rose-700 hover:bg-rose-50\" data-kid=\"1-2-2-3-1-2\" data-name=\"delete button\">\n                        Hapus\n                    </button>\n                </div>\n                <p class=\"mt-1.5 text-center text-[10px] text-slate-400\" data-kid=\"1-2-2-3-2\" data-name=\"disclaimer\">\n                    Perubahan hanya tersimpan setelah dikonfirmasi server.\n                </p>\n            </div>\n        </aside>\n    </main>\n</div>\n",
