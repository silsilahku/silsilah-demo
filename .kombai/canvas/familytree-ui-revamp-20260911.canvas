      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  :root { color-scheme: light; }\n  html, body { margin: 0; min-height: 100%; background: #f1f5f9; }\n  button, input { font: inherit; }\n  .family-app { font-family: 'Inter', sans-serif; min-height: 860px; color: #1e293b; background: #f1f5f9; }\n  .main-shell { height: 796px; }\n  .member-index { width: 272px; flex: 0 0 272px; }\n  .inspector { width: 352px; flex: 0 0 352px; }\n  .canvas-area { min-width: 0; flex: 1 1 auto; }\n  .tree-surface { background-color: #f8fafc; background-image: linear-gradient(to right, rgba(226,232,240,.34) 1px, transparent 1px), linear-gradient(to bottom, rgba(226,232,240,.28) 1px, transparent 1px); background-size: 32px 32px; }\n  .tree-card { width: 198px; height: 98px; }\n  .tree-card.selected { width: 212px; height: 106px; }\n  .mobile-search-launcher { display: none; }\n  .icon-button { min-width: 40px; min-height: 40px; }\n  .focus-ring:focus-visible { outline: 2px solid #4f46e5; outline-offset: 2px; }\n  .scrollbar::-webkit-scrollbar { width: 5px; }\n  .scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 999px; }\n  @media (max-width: 900px) {\n    .family-app { min-height: 100dvh; }\n    .app-header { height: 64px !important; padding: 0 14px !important; }\n    .desktop-only, .member-index { display: none !important; }\n    .app-header > button[aria-label=\"Buka menu\"] { display: flex !important; }\n    .main-shell { height: calc(100dvh - 64px); display: block !important; }\n    .canvas-area { width: 100%; height: 100%; }\n    .mobile-search-launcher { display: flex; position: absolute; top: 12px; left: 12px; right: 12px; z-index: 20; }\n    .inspector { display: flex !important; position: fixed; z-index: 50; inset: 64px 0 0; width: auto; max-width: none; flex: none; border-left: 0 !important; border-top: 1px solid #e2e8f0; border-radius: 22px 22px 0 0; box-shadow: 0 -10px 30px rgba(15,23,42,.12); }\n    .inspector .inspector-scroll { padding-bottom: 92px !important; }\n    .inspector .mobile-grab { display: block !important; }\n    .tree-surface { background-size: 24px 24px; }\n    .canvas-context { top: 70px !important; left: 12px !important; right: 12px !important; }\n  }\n</style>\n<div class=\"family-app w-full overflow-hidden\" data-kid=\"1\" data-name=\"main app container\">\n    <header class=\"app-header h-16 flex items-center gap-5 border-b border-slate-200 bg-white px-5 shadow-[0_1px_8px_rgba(15,23,42,0.05)] relative z-40\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"flex min-w-[222px] items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand and family summary section\">\n            <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-600 shadow-sm shadow-indigo-600/20\" data-kid=\"1-1-1-1\" data-name=\"logo icon container\">\n                <svg aria-hidden=\"true\" class=\"h-6 w-6 text-emerald-300\" data-kid=\"1-1-1-1-1\" data-name=\"family tree logo icon\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                    <path d=\"M12 2.5c-1.2 0-2.1 1-2.1 2.2v1.1C7.8 6.2 6.2 8.1 6.2 10.4c0 .4.1.8.2 1.2-1.5.7-2.5 2.2-2.5 4 0 2.4 1.9 4.3 4.3 4.3h2.7v1.8h2.2v-1.8h2.6c2.4 0 4.3-1.9 4.3-4.3 0-1.8-1-3.3-2.5-4 .1-.4.2-.8.2-1.2 0-2.3-1.6-4.2-3.7-4.6V4.7c0-1.2-.9-2.2-2.1-2.2h-1.7Z\">\n                    </path>\n                </svg>\n            </div>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"family name and stats group\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-1\" data-name=\"family name and badge group\">\n                    <h1 class=\"truncate text-[13px] font-bold tracking-[-0.01em] text-slate-800\" data-kid=\"1-1-1-2-1-1\" data-name=\"family name headline\">\n                        Garis Keturunan\n                    </h1>\n                    <span class=\"rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700\" data-kid=\"1-1-1-2-1-2\" data-name=\"admin badge\">\n                        Admin\n                    </span>\n                </div>\n                <div class=\"mt-0.5 flex items-center gap-2\" data-kid=\"1-1-1-2-2\" data-name=\"member count and description group\">\n                    <span class=\"rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-600\" data-kid=\"1-1-1-2-2-1\" data-name=\"member count pill\">\n                        94 anggota\n                    </span>\n                    <span class=\"desktop-only text-[10px] text-slate-400\" data-kid=\"1-1-1-2-2-2\" data-name=\"archive description text\">\n                        Arsip silsilah keluarga\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"desktop-only ml-auto flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"desktop navigation buttons group\">\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-1\" data-name=\"view mode selector button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-1-1\" data-name=\"view icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 12h16M14 6l6 6-6 6\">\n                    </path>\n                </svg>\n                Tampilan\n                <svg class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-2-1-2\" data-name=\"dropdown arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"m7 10 5 5 5-5\">\n                    </path>\n                </svg>\n            </button>\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-2\" data-name=\"statistics button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-2-1\" data-name=\"chart icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 19V5M4 19h16M7 16l3-4 3 2 4-6\">\n                    </path>\n                </svg>\n                Statistik\n            </button>\n            <button class=\"focus-ring flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium text-slate-600 hover:bg-slate-50\" data-kid=\"1-1-2-3\" data-name=\"data family button\">\n                <svg class=\"h-4 w-4 text-slate-500\" data-kid=\"1-1-2-3-1\" data-name=\"list icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M4 7h16M4 12h16M4 17h10\">\n                    </path>\n                </svg>\n                Data keluarga\n                <svg class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-2-3-2\" data-name=\"dropdown arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"m7 10 5 5 5-5\">\n                    </path>\n                </svg>\n            </button>\n            <button aria-label=\"Keluar dari akun\" class=\"focus-ring icon-button flex items-center justify-center rounded-lg border border-rose-200 bg-rose-50 text-rose-700\" data-kid=\"1-1-2-4\" data-name=\"logout button\">\n                <svg class=\"h-4 w-4\" data-kid=\"1-1-2-4-1\" data-name=\"logout icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                    <path d=\"M9 21H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9\">\n                    </path>\n                </svg>\n            </button>\n        </div>\n        <button aria-label=\"Buka menu\" class=\"focus-ring icon-button ml-auto hidden items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600\" data-kid=\"1-1-3\" data-name=\"mobile menu toggle button\">\n            <svg class=\"h-5 w-5\" data-kid=\"1-1-3-1\" data-name=\"menu icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                <path d=\"M4 6h16M4 12h16M4 18h16\">\n                </path>\n            </svg>\n        </button>\n    </header>\n    <div class=\"main-shell flex\" data-kid=\"1-2\" data-name=\"main layout shell\">\n        <aside class=\"member-index flex flex-col border-r border-slate-200 bg-white\" data-kid=\"1-2-1\" data-name=\"member index sidebar\">\n            <div class=\"border-b border-slate-100 px-4 pb-3 pt-4\" data-kid=\"1-2-1-1\" data-name=\"index header\">\n                <div class=\"flex items-end justify-between\" data-kid=\"1-2-1-1-1\" data-name=\"index title and count group\">\n                    <div data-kid=\"1-2-1-1-1-1\" data-name=\"index title block\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"archive title label\">\n                            Arsip keluarga\n                        </p>\n                        <h2 class=\"mt-1 text-sm font-bold text-slate-800\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"member list heading\">\n                            Daftar anggota\n                        </h2>\n                    </div>\n                    <span class=\"text-[11px] font-semibold text-slate-500\" data-kid=\"1-2-1-1-1-2\" data-name=\"member count text\">\n                        94 orang\n                    </span>\n                </div>\n                <label class=\"mt-3 block\" data-kid=\"1-2-1-1-2\" data-name=\"search input container\">\n                    <span class=\"sr-only\" data-kid=\"1-2-1-1-2-1\" data-name=\"search label\">\n                        Cari nama atau nama panggilan\n                    </span>\n                    <div class=\"flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 focus-within:border-indigo-400 focus-within:ring-2 focus-within:ring-indigo-100\" data-kid=\"1-2-1-1-2-2\" data-name=\"search field wrapper\">\n                        <svg class=\"h-4 w-4 shrink-0 text-slate-400\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"search magnifying glass icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n                            <circle cx=\"11\" cy=\"11\" r=\"7\">\n                            </circle>\n                            <path d=\"m20 20-4-4\">\n                            </path>\n                        </svg>\n                        <input class=\"w-full bg-transparent text-xs text-slate-800 outline-none placeholder:text-slate-400\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"member search input\" placeholder=\"Cari nama atau nama panggilan\" readonly=\"\" value=\"Ali\"/>\n                        <kbd class=\"rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[9px] font-medium text-slate-400\" data-kid=\"1-2-1-1-2-2-3\" data-name=\"search shortcut key label\">\n                            /\n                        </kbd>\n                    </div>\n                </label>\n            </div>\n            <div class=\"scrollbar flex-1 overflow-y-auto px-2 py-3\" data-kid=\"1-2-1-2\" data-name=\"members list\">\n                <div class=\"mb-4\" data-kid=\"1-2-1-2-1\" data-name=\"member group A\">\n                    <p class=\"px-2 pb-1 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400\" data-kid=\"1-2-1-2-1-1\" data-name=\"alphabet label A\">\n                        A\n                    </p>\n                    <button class=\"focus-ring flex h-[52px] w-full items-center gap-2.5 rounded-lg px-2 text-left hover:bg-slate-50\" data-kid=\"1-2-1-2-1-2\" data-name=\"Adi member button\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-[11px] font-bold text-amber-700\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"Adi avatar initials\">\n                            A\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"Adi name and age group\">\n                            <span class=\"block truncate text-xs font-semibold text-slate-700\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"Adi name\">\n                                Adi\n                            </span>\n                            <span class=\"block truncate text-[10px] text-slate-400\" data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"Adi age\">\n                                42 tahun\n                            </span>\n                        </span>\n                    </button>\n                    <button class=\"focus-ring flex h-[52px] w-full items-center gap-2.5 rounded-lg bg-indigo-50 px-2 text-left ring-1 ring-inset ring-indigo-200\" data-kid=\"1-2-1-2-1-3\" data-name=\"Ali member button\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-[11px] font-bold text-indigo-700\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"Ali avatar initials\">\n                            A\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"Ali name and info group\">\n                            <span class=\"block truncate text-xs font-bold text-indigo-900\" data-kid=\"1-2-1-2-1-3-2-1\" data-name=\"Ali display name\">\n                                Ali / iis\n                            </span>\n                            <span class=\"block truncate text-[10px] text-indigo-600\" data-kid=\"1-2-1-2-1-3-2-2\" data-name=\"Ali full name and age\">\n                                Ali Iskandar · 45 tahun\n                            </span>\n                        </span>\n                        <svg class=\"h-4 w-4 shrink-0 text-indigo-500\" data-kid=\"1-2-1-2-1-3-3\" data-name=\"chevron right icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\">\n                            <path d=\"m9 18 6-6-6-6\">\n                            </path>\n                        </svg>\n                    </button>\n                    <button class=\"focus-ring flex h-[52px] w-full items-center gap-2.5 rounded-lg px-2 text-left hover:bg-slate-50\" data-kid=\"1-2-1-2-1-4\" data-name=\"Amirah member button\">\n                        <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[11px] font-bold text-slate-600\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"Amirah avatar initials\">\n                            A\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"Amirah name and age group\">\n                            <span class=\"block truncate text-xs font-semibold text-slate-700\" data-kid=\"1-2-1-2-1-4-2-1\" data-name=\"Amirah name\">\n                                Amirah\n                            </span>\n                            <span class=\"block truncate text-[10px] text-slate-400\" data-kid=\"1-2-1-2-1-4-2-2\" data-name=\"Amirah age\">\n                                11 tahun\n                            </span>\n                        </span>\n                    </button>\n                </div>\n                <div class=\"mb-4\" data-kid=\"1-2-1-2-2\" data-name=\"member group B\">\n                    <p class=\"px-2 pb-1 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400\" data-kid=\"1-2-1-2-2-1\" data-name=\"alphabet label B\">\n                        B\n                    </p>\n                    <button class=\"focus-ring flex h-[52px] w-full items-center gap-2.5 rounded-lg px-2 text-left hover:bg-slate-50\" data-kid=\"1-2-1-2-2-2\" data-name=\"Boim member button\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-blue-100 text-[11px] font-bold text-blue-700\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"Boim avatar initials\">\n                            B\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"Boim name and role group\">\n                            <span class=\"block truncate text-xs font-semibold text-slate-700\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"Boim name\">\n                                Boim\n                            </span>\n                            <span class=\"block text-[10px] text-slate-400\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"Boim role\">\n                                Anggota keluarga\n                            </span>\n                        </span>\n                    </button>\n                    <button class=\"focus-ring flex h-[52px] w-full items-center gap-2.5 rounded-lg px-2 text-left hover:bg-slate-50\" data-kid=\"1-2-1-2-2-3\" data-name=\"Banafsha member button\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-pink-100 text-[11px] font-bold text-pink-700\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"Banafsha avatar initials\">\n                            B\n                        </span>\n                        <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"Banafsha name and age group\">\n                            <span class=\"block truncate text-xs font-semibold text-slate-700\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"Banafsha name\">\n                                Banafsha\n                            </span>\n                            <span class=\"block text-[10px] text-slate-400\" data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"Banafsha age\">\n                                9 tahun\n                            </span>\n                        </span>\n                   